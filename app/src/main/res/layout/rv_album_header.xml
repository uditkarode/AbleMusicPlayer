<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/album_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:paddingHorizontal="4dp">

    <FrameLayout
        android:id="@+id/album_art_frame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:riv_corner_radius="5dp"
            android:contentDescription="@string/add_song" />

        <ProgressBar
            android:id="@+id/album_art_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="#94BCE3"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/album_art_frame"
        android:layout_toStartOf="@+id/album_chevron"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/album_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94BCE3"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/album_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A8A8A7"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/album_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:text="▸"
        android:textColor="#94BCE3"
        android:textSize="18sp" />

</RelativeLayout>
