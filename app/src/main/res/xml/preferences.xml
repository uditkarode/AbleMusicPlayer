<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<ListPreference
        android:defaultValue="Youtube Music"
        android:entries="@array/sources"
        android:entryValues="@array/sources"
        android:summary="@string/pref_search"
        app:iconSpaceReserved="false"
        android:title="@string/src"
        android:key="source_key"
        />

    <ListPreference
        android:defaultValue="Download"
        android:entries="@array/modes"
        android:entryValues="@array/modes"
        android:summary="@string/play_mode_sum"
        app:iconSpaceReserved="false"
        android:title="@string/play_mode"
        android:key="mode_key"
        />

    <SwitchPreferenceCompat
        android:key="view_mode_grid"
        android:defaultValue="false"
        app:iconSpaceReserved="false"
        android:title="@string/pref_view_mode"
        android:summary="@string/pref_view_mode_sum"
        />

    <ListPreference
        android:key="grid_column_count"
        android:defaultValue="2"
        android:entries="@array/grid_columns"
        android:entryValues="@array/grid_columns_values"
        app:iconSpaceReserved="false"
        android:title="@string/pref_grid_columns"
        android:summary="@string/pref_grid_columns_sum"
        />

    <Preference
        android:title="@string/downloads_title"
        app:iconSpaceReserved="false"
        android:summary="@string/downloads_pref_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.uditkarode.able"
            android:targetClass="io.github.uditkarode.able.activities.Downloads"
            />
    </Preference>

    <Preference
        android:title="@string/about"
        app:iconSpaceReserved="false"
        android:summary="@string/pref_about">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.uditkarode.able"
            android:targetClass="io.github.uditkarode.able.activities.About"
            />
    </Preference>

    <PreferenceCategory
        android:title="@string/devlog_category"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="developer_logs"
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            android:title="@string/pref_dev_logs"
            android:summary="@string/pref_dev_logs_sum"
            />

        <Preference
            android:key="export_logs"
            app:iconSpaceReserved="false"
            android:title="@string/pref_export_logs"
            android:summary="@string/pref_export_logs_sum"
            />
    </PreferenceCategory>
</PreferenceScreen>